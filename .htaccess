RewriteEngine On
RewriteOptions Inherit

# ── 1) Force HTTPS (behind proxy/CDN safe)
# Redirect only if Apache didn't negotiate HTTPS AND proxy didn't send https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2) Canonical host: force non-www
RewriteCond %{HTTP_HOST} ^www\.wamuk\.org$ [NC]
RewriteRule ^ https://wamuk.org%{REQUEST_URI} [L,R=301]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php73” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php73 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
