RewriteEngine On
RewriteOptions Inherit

# ── 1) Force HTTPS (behind proxy/CDN safe)
# Redirect only if Apache didn't negotiate HTTPS AND proxy didn't send https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2) Canonical host: force non-www
RewriteCond %{HTTP_HOST} ^www\.wamuk\.org$ [NC]
RewriteRule ^ https://wamuk.org%{REQUEST_URI} [L,R=301]

# ── 3) Security hardening
# Disable directory listing
Options -Indexes

# Protect hidden files and directories (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
